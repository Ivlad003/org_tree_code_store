ADMIN_EMAIL=admin@code.store
ADMIN_PASSWORD=changeme

# Viewer gate: "open" = public chart (no auth), "google" = require @code.store Google sign-in
VIEWER_AUTH=google

# Google OAuth (viewer gate) — create credentials in Google Cloud Console.
# The redirect URI registered there must equal OAUTH_REDIRECT_URI exactly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_REDIRECT_URI=https://your-domain.example/auth_google.php
